# Local secrets and environment-specific settings. Copy to .env and fill in the values.

# Database
DB_HOST=127.0.0.1
DB_USER=webpush_app
DB_PASSWORD=
DB_NAME=webpush
DB_PORT=3306
# Connection pool: max connections, seconds to wait for a free one, seconds after which an idle connection
# is reopened (keep it below the wait_timeout of MariaDB), seconds to wait for a new connection and for a query
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=60

# Web app (console and API)
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_THREADS=8
WEB_BEHIND_PROXY=false
WEB_DEBUG=false
# Public url of the application as the browsers of the sites reach it (base of the API, without the final /)
PUBLIC_URL=http://127.0.0.1:8080
# Secret used to sign the login tokens of the console (at least 32 bytes)
JWT_SECRET_KEY=

# Sending: parallel requests to the push services, seconds to wait for each one,
# consecutive failures before a subscriber is removed (404 / 410 remove it at once)
PUSH_WORKERS=10
PUSH_TIMEOUT=10
PUSH_MAX_FAILURES=5

# Site (its code) of the old endpoints /subscription/ and /push_message/, empty = disabled
DEFAULT_SITE=

# Errors (page Errors): days they are kept, max errors saved by the process
ERROR_LOG_RETENTION_DAYS=30
ERROR_LOG_MAX_PER_PROCESS=500

# Pages Home, Messages, Subscribers and Errors: seconds of the automatic refresh (0 = off), changeable on each page
REFRESH_SECONDS=15

LOG_LEVEL=INFO
